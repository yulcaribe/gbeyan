{
  "manifest_version": 3,
  "name": "OtoBeyan iGO Köprüsü",
  "version": "0.1.3",
  "description": "Açık iGO oturumundan yalnızca uçuş ve Load Sheet verisi okur.",
  "permissions": ["scripting"],
  "host_permissions": ["https://igo.sunexpress.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OtoBeyan iGO Köprüsü",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
