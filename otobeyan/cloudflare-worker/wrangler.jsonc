{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "igo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IGO_SESSION_STORE",
        "class_name": "IgoSessionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IgoSessionStore"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
